{
  "scope": "off",
  "authors": [],
  "repoAllowlist": [],
  "maxConcurrentAutoReviews": 2,
  "requireCiPass": true,
  "maxBehindBase": 10,
  "dispatchTimeoutHours": 24,
  "ignorePatterns": ["*PB-000-index*", "*ED-000-index*"],
  "defaultRule": {
    "reviewerKey": "default",
    "autoVerdict": false,
    "autoVerdictMode": "verdict"
  },
  "rules": [
    {
      "name": "PB",
      "patterns": ["PB-[0-9]*"],
      "reviewerKey": "pb",
      "autoVerdict": true,
      "autoVerdictMode": "verdict"
    },
    {
      "name": "ED",
      "patterns": ["ED-[0-9]*"],
      "reviewerKey": "ed",
      "autoVerdict": true,
      "autoVerdictMode": "verdict"
    }
  ]
}
